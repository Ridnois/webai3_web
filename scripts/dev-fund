#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# Fund Anvil test accounts with USDC on the local fork.
#
# This script uses Foundry's `cast` to impersonate the USDC masterMinter,
# configure a minter, and mint USDC to each test account.
#
# Run this AFTER `scripts/dev-chain` is up.
#
# Usage:
#   ./scripts/dev-fund                          # fund default accounts
#   ./scripts/dev-fund 0xYourAddress            # fund a specific address too
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

# Ensure Foundry binaries are on PATH
export PATH="$HOME/.foundry/bin:$PATH"

RPC_URL="${RPC_URL:-http://127.0.0.1:8545}"
USDC="0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238"
AMOUNT="1000000000000"  # 1 000 000 USDC (6 decimals = 10^12)

# Anvil's default test accounts (from the standard "test test ... junk" mnemonic)
ACCOUNTS=(
  "0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266"
  "0x70997970C51812dc3A010C7d01b50e0d17dc79C8"
  "0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC"
  "0x90F79bf6EB2c4f870365E785982E1f101E93b906"
  "0x15d34AAf54267DB7D7c367839AAf71A00a2C6A65"
)

# Add any extra addresses passed as arguments
ACCOUNTS+=("$@")

if ! command -v cast &>/dev/null; then
  echo "Error: cast not found. Install Foundry first:"
  echo "  curl -L https://foundry.paradigm.xyz | bash && foundryup"
  exit 1
fi

# Check Anvil is running
if ! cast chain-id --rpc-url "$RPC_URL" &>/dev/null; then
  echo "Error: cannot connect to $RPC_URL — is Anvil running?"
  echo "  Start it with: pnpm chain:start"
  exit 1
fi

echo "Funding test accounts with USDC on local Anvil fork..."
echo "  RPC  : $RPC_URL"
echo "  USDC : $USDC"
echo ""

# ── Strategy: try masterMinter → configureMinter → mint ──────────────────────
# Circle's FiatToken has a masterMinter that can authorise minters.
# On the fork, we impersonate the masterMinter to grant minting rights,
# then mint USDC directly to each test account.

# Read masterMinter address from the USDC contract
MASTER_MINTER=$(cast call "$USDC" "masterMinter()(address)" --rpc-url "$RPC_URL" 2>/dev/null || echo "")

if [ -n "$MASTER_MINTER" ] && [ "$MASTER_MINTER" != "0x0000000000000000000000000000000000000000" ]; then
  echo "Found masterMinter: $MASTER_MINTER"
  echo "Using mint strategy..."

  # Fund the masterMinter with ETH so it can pay for gas
  cast rpc anvil_setBalance "$MASTER_MINTER" "0x56BC75E2D63100000" --rpc-url "$RPC_URL" >/dev/null

  # Impersonate the masterMinter
  cast rpc anvil_impersonateAccount "$MASTER_MINTER" --rpc-url "$RPC_URL" >/dev/null

  # Use Account #0 as our minter
  MINTER="${ACCOUNTS[0]}"

  # configureMinter(minter, minterAllowedAmount)
  # Allow the minter to mint a very large amount
  ALLOWANCE="115792089237316195423570985008687907853269984665640564039457584007913129639935"  # uint256 max
  cast send "$USDC" "configureMinter(address,uint256)(bool)" "$MINTER" "$ALLOWANCE" \
    --from "$MASTER_MINTER" --unlocked --rpc-url "$RPC_URL" >/dev/null 2>&1

  cast rpc anvil_stopImpersonatingAccount "$MASTER_MINTER" --rpc-url "$RPC_URL" >/dev/null

  # Now mint USDC to each account using the configured minter
  # mint(address,uint256)(bool)
  # Account #0 private key (Anvil default mnemonic)
  MINTER_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"

  for ACCT in "${ACCOUNTS[@]}"; do
    if [ -z "$ACCT" ]; then continue; fi
    echo "  Minting 1,000,000 USDC → $ACCT"
    cast send "$USDC" "mint(address,uint256)(bool)" "$ACCT" "$AMOUNT" \
      --private-key "$MINTER_KEY" --rpc-url "$RPC_URL" >/dev/null 2>&1
  done

  echo ""
  echo "Done! Verifying balances..."
else
  # ── Fallback: direct storage manipulation ──────────────────────────────────
  echo "masterMinter not found — using direct storage manipulation..."
  echo ""

  for ACCT in "${ACCOUNTS[@]}"; do
    if [ -z "$ACCT" ]; then continue; fi

    # ERC-20 balanceOf mapping is commonly at storage slot 9 for USDC (FiatTokenV2)
    # slot = keccak256(abi.encode(address, uint256(9)))
    SLOT=$(cast index address "$ACCT" 9)

    # Encode the amount as a 32-byte hex value
    HEX_AMOUNT=$(cast to-uint256 "$AMOUNT")

    echo "  Setting 1,000,000 USDC → $ACCT (slot $SLOT)"
    cast rpc anvil_setStorageAt "$USDC" "$SLOT" "$HEX_AMOUNT" --rpc-url "$RPC_URL" >/dev/null
  done

  echo ""
  echo "Done! Verifying balances..."
fi

# ── Print balances ───────────────────────────────────────────────────────────
echo ""
for ACCT in "${ACCOUNTS[@]}"; do
  if [ -z "$ACCT" ]; then continue; fi
  RAW=$(cast call "$USDC" "balanceOf(address)(uint256)" "$ACCT" --rpc-url "$RPC_URL" 2>/dev/null)
  # cast returns values like "1000312790637 [1e12]" — extract the numeric part
  NUM=$(echo "$RAW" | grep -oP '^\d+' || echo "0")
  # Integer division by 1000000 (USDC has 6 decimals) — show whole USDC
  WHOLE=$((NUM / 1000000))
  FRAC=$(printf "%06d" $((NUM % 1000000)) | head -c 2)
  echo "  $ACCT  →  ${WHOLE}.${FRAC} USDC"
done

echo ""
echo "Test accounts are funded and ready!"
echo ""
echo "To import Account #0 into MetaMask:"
echo "  Private key: 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"
echo "  Network RPC: http://127.0.0.1:8545"
echo "  Chain ID:    31337"
