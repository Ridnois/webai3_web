# ─── Local development overrides ──────────────────────────────────────────────
# Copy this file to .env.local to enable local Anvil testing.
# .env.local is loaded by Next.js and overrides values in .env.
#
# Usage:
#   1. cp .env.local.example .env.local
#   2. pnpm chain:start          (start Anvil in a separate terminal)
#   3. pnpm chain:fund           (fund test accounts with USDC)
#   4. pnpm dev                  (start the app)
#   5. In MetaMask, add a custom network:
#        Network name: Anvil Local
#        RPC URL:      http://127.0.0.1:8545
#        Chain ID:     31337
#        Symbol:       ETH
#   6. Import Anvil Account #0:
#        Private key: 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# ─────────────────────────────────────────────────────────────────────────────

# Enable the local Foundry/Anvil chain (chainId 31337) in the wallet connector
NEXT_PUBLIC_ENABLE_DEV_CHAIN=true

# Set the receiver address to Anvil Account #1 for local testing
RECEIVER_ADDRESS=0x70997970C51812dc3A010C7d01b50e0d17dc79C8
NEXT_PUBLIC_RECEIVER_ADDRESS=0x70997970C51812dc3A010C7d01b50e0d17dc79C8
