# ─── Local development overrides ──────────────────────────────────────────────
# Copy this file to .env.local to enable local testing.
# .env.local is loaded by Next.js and overrides values in .env.
#
# Note: The x402 facilitator does NOT support local Anvil chains.
# For payment testing, use Base Sepolia testnet.
#
# Usage:
#   1. cp .env.local.example .env.local
#   2. pnpm dev                  (start the app)
#   3. Connect wallet to Base Sepolia in MetaMask
# ─────────────────────────────────────────────────────────────────────────────

# Enable the local Foundry/Anvil chain (chainId 31337) in the wallet connector
# (only useful for non-payment testing; facilitator won't work with Anvil)
NEXT_PUBLIC_ENABLE_DEV_CHAIN=true

# Set the receiver address to Anvil Account #1 for local testing
RECEIVER_ADDRESS=0x70997970C51812dc3A010C7d01b50e0d17dc79C8

# x402 facilitator (testnet)
X402_FACILITATOR_URL=https://www.x402.org/facilitator
