# Copy to .env and fill in values.
#
# Required server-side variables
REPLICATE_API_TOKEN=
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
SESSION_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://pub-xxxx.r2.dev
RECEIVER_ADDRESS=0x0000000000000000000000000000000000000000

# Optional server-side variables
# INFERENCE_RATE_PER_SEC=0.001
# X402_FACILITATOR_URL=https://facilitator.x402.fi   # RelAI — supports eip155:1 (Ethereum mainnet)
# ADMIN_ADDRESSES=0xabc...,0xdef...

# Optional client-side variables
# NEXT_PUBLIC_ETHEREUM_RPC_URL=https://eth.llamarpc.com
# NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# NEXT_PUBLIC_ENABLE_DEV_CHAIN=true

# Optional local Anvil testing overrides
# NEXT_PUBLIC_ENABLE_DEV_CHAIN=true
# RECEIVER_ADDRESS=0x70997970C51812dc3A010C7d01b50e0d17dc79C8
# X402_FACILITATOR_URL=https://facilitator.x402.fi
