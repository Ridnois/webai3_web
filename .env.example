# ─── server-only ────────────────────────────────────────────────────────────────

# replicate api — https://replicate.com/account/api-tokens
replicate_api_token=

# postgresql connection string
database_url=postgresql://user:password@localhost:5432/dbname

# iron-session encryption secret — must be at least 32 random characters
session_secret=

# cloudflare r2 — https://dash.cloudflare.com/ → r2 → manage api tokens
r2_account_id=
r2_access_key_id=
r2_secret_access_key=
r2_bucket_name=

# (optional) public cdn url for the r2 bucket
# r2_public_url=https://pub-xxxx.r2.dev

# wallet address that receives usdc payments for inferences
receiver_address=0x...

# (optional) usdc cost per second of replicate predict time — defaults to 0.001
# inference_rate_per_sec=0.001

# ─── client-side (next_public_*) ─────────────────────────────────────────────

# (optional) custom rpc urls — falls back to public endpoints if omitted
# next_public_base_rpc_url=https://mainnet.base.org
# next_public_base_sepolia_rpc_url=https://sepolia.base.org

# receiver address exposed to client for erc-20 transfer calls (same as receiver_address)
next_public_receiver_address=0x...

# (optional) enable the local Anvil dev chain (chainId 31337) — see .env.local.example
# next_public_enable_dev_chain=true
